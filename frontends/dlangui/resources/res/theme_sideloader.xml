<?xml version="1.0" encoding="utf-8"?>
<!--
    Sideloader — theme "graphite + bleu iOS".

    Herite de theme_dark pour recuperer les assets sombres de dlangui
    (cases a cocher, fleches, ascenseurs) puis remplace tout ce qui est
    visible par des aplats + bordures 1px : dlangui dessine les fonds via
    `backgroundColor` et `border="#RRGGBB,largeur"`, ce qui evite de
    dependre des PNG 9-patch en degrade d'origine.

    Palette
      fond          #1C1D21     bordure       #3A3B42
      surface       #26272C     bordure douce #2F3037
      surface haute #2E2F35     texte         #ECECEF
      champ         #1F2025     texte attenue #9A9BA3
      accent        #0A84FF     texte inactif #64656D
      danger        #FF453A
-->
<!--
    Police : dlangui rend via GDI sous Windows (pas FreeType), donc les
    reglages de gamma/hinting de FontManager sont sans effet ici — seuls la
    fonte et le corps comptent. Segoe UI ressortait trop maigre.
    La liste est essayee dans l'ordre, premiere installee retenue.
-->
<theme id="theme_sideloader" parent="theme_dark"
        textColor="#ECECEF"
        fontSize="11pt"
        fontFace="Roboto,Segoe UI Variable Text,Lato,Segoe UI,Verdana,DejaVu Sans"
        fontFamily="SansSerif"
        >
    <color id="window_background" value="#1C1D21"/>
    <color id="dialog_background" value="#26272C"/>
    <color id="edit_background" value="#1F2025"/>
    <color id="edit_caret" value="#ECECEF"/>
    <color id="file_dialog_dir_name_color" value="#0A84FF"/>

    <color id="grid_selection_color" value="#600A84FF"/>
    <color id="grid_selection_color_row" value="#400A84FF"/>
    <color id="grid_cell_background_fixed" value="#2E2F35"/>
    <color id="grid_cell_border_color" value="#3A3B42"/>
    <color id="grid_cell_border_color_header" value="#3A3B42"/>
    <color id="grid_cell_background_header" value="#26272C"/>
    <color id="grid_cell_background_header_selected" value="#0A84FF"/>

    <!-- ==================== styles applicatifs ==================== -->

    <!-- conteneur de page : c'est lui qui donne la respiration generale -->
    <style id="SL_PAGE"
        backgroundColor="#1C1D21"
        padding="14pt,12pt,14pt,12pt"
        layoutWidth="FILL_PARENT"
        layoutHeight="FILL_PARENT"
        />

    <!-- intitule de section, au-dessus d'un groupe de champs -->
    <style id="SL_CAPTION"
        textColor="#9A9BA3"
        fontSize="9pt"
        fontWeight="bold"
        margins="0,0,0,4pt"
        align="Left|VCenter"
        />

    <!-- libelle d'un champ (colonne de gauche) -->
    <style id="SL_LABEL"
        textColor="#9A9BA3"
        margins="0,0,12pt,0"
        padding="0,5pt,0,5pt"
        align="Left|VCenter"
        />

    <!-- valeur en lecture seule : du texte, pas un champ de saisie grise -->
    <style id="SL_VALUE"
        textColor="#ECECEF"
        padding="0,5pt,0,5pt"
        align="Left|VCenter"
        layoutWidth="FILL_PARENT"
        />

    <style id="SL_BODY"
        textColor="#C6C7CE"
        margins="0,0,0,3pt"
        align="Left|VCenter"
        />

    <style id="SL_PARAGRAPH"
        textColor="#C6C7CE"
        margins="0,0,0,4pt"
        align="Left|VCenter"
        maxLines="0"
        maxWidth="480"
        />

    <style id="SL_HINT"
        textColor="#7C7E88"
        fontSize="9pt"
        align="Center"
        margins="0,6pt,0,0"
        />

    <style id="SL_ERROR"
        textColor="#FF453A"
        margins="0,4pt,0,4pt"
        align="Left|VCenter"
        />

    <!-- message plein cadre quand il n'y a rien a afficher -->
    <!-- maxLines="0" : c'est ce qui bascule un TextWidget en multi-ligne
         dans dlangui. Sans lui, les \n sortent en glyphe manquant. -->
    <style id="SL_EMPTY"
        textColor="#9A9BA3"
        align="Center"
        padding="16pt,24pt,16pt,24pt"
        maxLines="0"
        layoutWidth="FILL_PARENT"
        layoutHeight="FILL_PARENT"
        />

    <style id="SL_SEPARATOR"
        backgroundColor="#2F3037"
        layoutWidth="FILL_PARENT"
        minHeight="1"
        maxHeight="1"
        margins="0,8pt,0,8pt"
        />

    <!-- ==================== controles ==================== -->

    <style id="BUTTON"
        backgroundImageId="@null"
        backgroundColor="#31333A"
        border="#41434C,1"
        textColor="#ECECEF"
        padding="10pt,6pt,10pt,6pt"
        margins="0,3pt,0,3pt"
        align="Center"
        focusRectColors="@null"
        textFlags="UnderlineHotKeys"
        >
        <state state_enabled="true" state_pressed="true" backgroundColor="#3E414B" border="#0A84FF,1"/>
        <state state_enabled="true" state_focused="true" backgroundColor="#3A3D46" border="#0A84FF,1"/>
        <state state_enabled="true" state_hovered="true" backgroundColor="#3A3D46" border="#53565F,1"/>
        <state state_enabled="false" backgroundColor="#25262B" border="#2F3037,1" textColor="#5E606A"/>
    </style>

    <!-- Action principale de l'ecran : un seul bouton accentue a la fois.
         Les proprietes de forme sont repetees et pas heritees de BUTTON :
         l'heritage entre styles du meme theme ne s'appliquait pas ici, le
         bouton retombait sur un rendu plat ferre a gauche. -->
    <style id="BUTTON_PRIMARY"
        backgroundImageId="@null"
        backgroundColor="#0A84FF"
        border="#0A84FF,1"
        textColor="#FFFFFF"
        padding="10pt,7pt,10pt,7pt"
        margins="0,3pt,0,3pt"
        align="Center"
        focusRectColors="@null"
        >
        <state state_enabled="true" state_pressed="true" backgroundColor="#0768CC" border="#0768CC,1" textColor="#FFFFFF"/>
        <state state_enabled="true" state_focused="true" backgroundColor="#329EFF" border="#8CC8FF,1" textColor="#FFFFFF"/>
        <state state_enabled="true" state_hovered="true" backgroundColor="#329EFF" border="#329EFF,1" textColor="#FFFFFF"/>
        <state state_enabled="false" backgroundColor="#1F3A55" border="#22415F,1" textColor="#6B8AA8"/>
    </style>

    <style id="BUTTON_NOMARGINS"
        backgroundImageId="@null"
        backgroundColor="#31333A"
        border="#41434C,1"
        textColor="#ECECEF"
        padding="10pt,6pt,10pt,6pt"
        margins="0,0,0,0"
        align="Center"
        focusRectColors="@null"
        >
        <state state_enabled="true" state_pressed="true" backgroundColor="#3E414B" border="#0A84FF,1"/>
        <state state_enabled="true" state_hovered="true" backgroundColor="#3A3D46" border="#53565F,1"/>
        <state state_enabled="false" backgroundColor="#25262B" border="#2F3037,1" textColor="#5E606A"/>
    </style>

    <style id="BUTTON_LABEL"
        layoutWidth="FILL_PARENT"
        textColor="#ECECEF"
        focusRectColors="@null"
        >
        <state state_enabled="false" textColor="#5E606A"/>
        <state state_enabled="true" state_hovered="true" textColor="#0A84FF"/>
    </style>

    <style id="BUTTON_LABEL_LINK" parent="BUTTON_LABEL"
        textColor="#0A84FF"
        >
        <state state_enabled="false" textColor="#3C5C7C"/>
        <state state_enabled="true" state_hovered="true" textColor="#329EFF" textFlags="Underline"/>
    </style>

    <style id="TEXT"
        textColor="#ECECEF"
        >
        <state state_enabled="false" textColor="#64656D"/>
    </style>

    <style id="MULTILINE_TEXT"
        textColor="#ECECEF"
        >
        <state state_enabled="false" textColor="#64656D"/>
    </style>

    <style id="EDIT_LINE"
        backgroundImageId="@null"
        backgroundColor="#1F2025"
        border="#3A3B42,1"
        textColor="#ECECEF"
        padding="8pt,6pt,8pt,6pt"
        margins="0,3pt,0,3pt"
        minWidth="40"
        >
        <state state_focused="true" border="#0A84FF,1"/>
        <state state_enabled="false" backgroundColor="#212227" border="#2F3037,1" textColor="#8A8C95"/>
    </style>

    <style id="EDIT_BOX"
        backgroundImageId="@null"
        backgroundColor="#1F2025"
        border="#3A3B42,1"
        textColor="#ECECEF"
        fontFace="Cascadia Mono,Consolas,DejaVu Sans Mono,Courier New"
        padding="8pt,6pt,8pt,6pt"
        margins="0,3pt,0,3pt"
        >
        <state state_focused="true" border="#0A84FF,1"/>
        <state state_enabled="false" backgroundColor="#212227" border="#2F3037,1" textColor="#8A8C95"/>
    </style>

    <style id="LIST_BOX"
        backgroundImageId="@null"
        backgroundColor="#1F2025"
        border="#3A3B42,1"
        />

    <style id="COMBO_BOX"
        backgroundImageId="@null"
        backgroundColor="#26272C"
        border="#3A3B42,1"
        padding="2,2,2,2"
        margins="0,3pt,0,3pt"
        minWidth="40"
        >
        <state state_focused="true" border="#0A84FF,1"/>
        <state state_hovered="true" border="#53565F,1"/>
    </style>

    <style id="COMBO_BOX_BODY"
        padding="8pt,6pt,8pt,6pt"
        textColor="#ECECEF"
        align="Left|VCenter"
        focusRectColors="@null"
        minWidth="40"
        />

    <style id="COMBO_BOX_BUTTON"
        backgroundImageId="@null"
        backgroundColor="@null"
        padding="6pt,2,6pt,2"
        align="Center"
        >
        <state state_hovered="true" backgroundColor="#31333A"/>
        <state state_pressed="true" backgroundColor="#3E414B"/>
    </style>

    <style id="LIST_ITEM"
        backgroundImageId="@null"
        backgroundColor="@null"
        padding="8pt,5pt,8pt,5pt"
        >
        <state state_selected="true" backgroundColor="#0A84FF"/>
        <state state_hovered="true" backgroundColor="#31333A"/>
    </style>

    <!-- ==================== onglets ==================== -->

    <!-- barre d'onglets : une simple ligne de separation sous les titres -->
    <style id="TAB_UP"
        backgroundImageId="@null"
        backgroundColor="#1C1D21"
        border="#2F3037,0,0,0,1"
        layoutWidth="FILL_PARENT"
        >
        <state state_selected="true" backgroundImageId="@null" backgroundColor="#1C1D21"/>
    </style>

    <!-- onglet actif : souligne accent, pas de "pilule" -->
    <style id="TAB_UP_BUTTON"
        backgroundImageId="@null"
        backgroundColor="@null"
        >
        <state state_selected="true" backgroundColor="@null" border="#0A84FF,0,0,0,2"/>
        <state state_hovered="true" backgroundColor="#26272C"/>
    </style>

    <style id="TAB_UP_BUTTON_TEXT"
        padding="10pt,7pt,10pt,7pt"
        textColor="#9A9BA3"
        align="Center"
        >
        <state state_selected="true" state_focused="true" textColor="#FFFFFF"/>
        <state state_selected="true" textColor="#FFFFFF"/>
        <state state_hovered="true" textColor="#ECECEF"/>
    </style>

    <style id="TAB_HOST"
        backgroundColor="#1C1D21"
        padding="0,10pt,0,0"
        layoutWidth="FILL_PARENT"
        layoutHeight="FILL_PARENT"
        />

    <style id="TAB_WIDGET"
        backgroundColor="#1C1D21"
        />

    <!-- ==================== menu principal ==================== -->

    <style id="MAIN_MENU"
        backgroundImageId="@null"
        backgroundColor="#232429"
        border="#2F3037,0,0,0,1"
        layoutWidth="FILL_PARENT"
        />

    <style id="MAIN_MENU_ITEM"
        backgroundImageId="@null"
        backgroundColor="@null"
        padding="8pt,5pt,8pt,5pt"
        textFlags="Parent"
        >
        <state state_selected="true" backgroundColor="#31333A"/>
        <state state_hovered="true" backgroundColor="#2E2F35"/>
    </style>

    <style id="MAIN_MENU_LABEL"
        margins="0,0,0,0"
        textColor="#ECECEF"
        align="Left|VCenter"
        textFlags="Parent"
        >
        <state state_enabled="false" textColor="#64656D"/>
    </style>

    <style id="POPUP_MENU"
        backgroundImageId="@null"
        backgroundColor="#2E2F35"
        border="#3A3B42,1"
        padding="0,4pt,0,4pt"
        />

    <style id="MENU_ITEM"
        backgroundImageId="@null"
        backgroundColor="@null"
        padding="8pt,4pt,8pt,4pt"
        >
        <state state_selected="true" backgroundColor="#0A84FF"/>
        <state state_hovered="true" backgroundColor="#3A3D46"/>
    </style>

    <style id="MENU_SEPARATOR"
        backgroundImageId="@null"
        backgroundColor="#3A3B42"
        padding="0,0,0,0"
        margins="8pt,4pt,8pt,4pt"
        minHeight="1"
        maxHeight="1"
        />

    <style id="MENU_LABEL"
        textColor="#ECECEF"
        margins="4,2,4,2"
        align="Left|VCenter"
        >
        <state state_enabled="false" textColor="#64656D"/>
    </style>

    <style id="MENU_ACCEL"
        textColor="#9A9BA3"
        margins="12pt,2,4,2"
        align="Left|VCenter"
        >
        <state state_enabled="false" textColor="#64656D"/>
    </style>

    <!-- ==================== divers ==================== -->

    <style id="PROGRESS_BAR"
        backgroundImageId="@null"
        backgroundColor="#26272C"
        border="#3A3B42,1"
        padding="0,0,0,0"
        margins="0,4pt,0,4pt"
        minWidth="50pt"
        minHeight="8pt"
        maxHeight="8pt"
        >
        <drawable id="progress_bar_gauge" value="#0A84FF"/>
        <drawable id="progress_bar_gauge_animation" value="@null"/>
        <drawable id="progress_bar_indeterminate" value="#0A84FF"/>
        <drawable id="progress_bar_indeterminate_animation" value="@null"/>
    </style>

    <style id="SCROLLBAR"
        backgroundColor="#232429"
        />

    <style id="TOOLTIP"
        backgroundImageId="@null"
        backgroundColor="#2E2F35"
        border="#3A3B42,1"
        textColor="#ECECEF"
        padding="8pt,5pt,8pt,5pt"
        />

    <style id="FLOATING_WINDOW"
        backgroundImageId="@null"
        backgroundColor="#26272C"
        border="#3A3B42,1"
        />

    <style id="STATUS_LINE"
        backgroundColor="#232429"
        textColor="#9A9BA3"
        padding="8pt,3pt,8pt,3pt"
        />

    <style id="STRING_GRID"
        backgroundImageId="@null"
        backgroundColor="#1F2025"
        border="#3A3B42,1"
        />

    <style id="FILE_DIALOG_GRID"
        backgroundImageId="@null"
        backgroundColor="#1F2025"
        border="#3A3B42,1"
        />

    <style id="GROUP_BOX_CAPTION"
        textColor="#9A9BA3"
        align="Left|VCenter"
        padding="1pt,1pt,1pt,1pt"
        />
</theme>
